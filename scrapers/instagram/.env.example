# Kopieer naar .env en vul in. .env staat in .gitignore — committen = verboden.

# Pad naar je instaloader-sessiebestand (zie README: "Eenmalig inloggen").
# instaloader schrijft dit standaard naar ~/.config/instaloader/session-<username>
IG_SESSION_FILE=/home/JOUW_USER/.config/instaloader/session-JOUW_BURNER

# Optioneel: username van het (BURNER!) account waarmee de sessie hoort.
# Mag leeg blijven; instaloader leidt 'm dan uit het sessiebestand af.
IG_USERNAME=

# Optioneel: standaard-pauze (seconden) tussen requests. Rustiger = veiliger.
IG_PAUSE=3

# Optioneel: standaard-uitvoermap voor Excel-bestanden.
IG_OUTPUT_DIR=output
